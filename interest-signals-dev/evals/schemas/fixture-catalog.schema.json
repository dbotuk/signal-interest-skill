{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/interest-signals/fixture-catalog.schema.json",
  "title": "Synthetic evaluation fixture catalog",
  "type": "object",
  "required": ["schema_version", "fixtures"],
  "additionalProperties": false,
  "$defs": {
    "generator": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {"type": {"const": "constant"}, "value": {"type": "number"}}
        },
        {
          "type": "object",
          "required": ["type", "base", "monthly_rate"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "exponential"},
            "base": {"type": "number"},
            "monthly_rate": {"type": "number", "exclusiveMinimum": -1}
          }
        },
        {
          "type": "object",
          "required": ["type", "base", "index", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "spike"},
            "base": {"type": "number"},
            "index": {"type": "integer", "minimum": 0},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "required": ["type", "base", "effects"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "seasonal"},
            "base": {"type": "number"},
            "monthly_rate": {"type": "number", "exclusiveMinimum": -1},
            "effects": {
              "type": "object",
              "patternProperties": {"^(0[1-9]|1[0-2])$": {"type": "number", "minimum": 0}},
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "before", "after", "split"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "level_shift"},
            "before": {"type": "number"},
            "after": {"type": "number"},
            "split": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "values"},
            "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixtures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["start", "series"],
        "additionalProperties": false,
        "properties": {
          "start": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["language", "title", "months", "raw", "share"],
              "additionalProperties": false,
              "properties": {
                "language": {"type": "string"},
                "title": {"type": "string"},
                "months": {"type": "integer", "minimum": 1},
                "gaps": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
                "raw": {"$ref": "#/$defs/generator"},
                "share": {"$ref": "#/$defs/generator"}
              }
            }
          }
        }
      }
    }
  }
}
